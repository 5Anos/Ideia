# GOOGLE OAUTH 2.0 (Configuração recomendada no servidor para fluxo Authorization Code + Refresh Token)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/company/sheets/oauth/callback"

# GOOGLE CLOUD & SECRET MANAGER (Opcional - caso contrário usa cofre cifrado AES-256-GCM no servidor)
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_SECRET_MANAGER_ENABLED="false"

# SEGURANÇA DE SESSÃO E CIFRAGEM (Obrigatório em produção - mínimo 32 caracteres)
MANDATO_SESSION_SECRET=""
MANDATO_MASTER_ENCRYPTION_KEY=""

# APLICAÇÃO
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PROVEDORES DE IA (Apenas no servidor - nunca expor no frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ADMINISTRADORES DE PLATAFORMA MANDATO (Emails separados por vírgula)
MANDATO_PLATFORM_ADMINS="direcao@demonstracao.pt"
