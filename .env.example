# GEMINI_API_KEY: Obrigatória para chamadas server-side à API Google Gemini.
# No AI Studio é injetada automaticamente a partir do painel Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL público onde a aplicação está alojada.
APP_URL="http://localhost:3000"

# MANDATO_SESSION_SECRET: Segredo HMAC para assinar tokens de sessão (gerado automaticamente em desenvolvimento se ausente).
MANDATO_SESSION_SECRET=""

# SUPABASE (Opcional): Configure para ligar a uma instância Supabase PostgreSQL + Auth em produção.
# Sem estas variáveis, o MANDATO utiliza a base de dados relacional SQLite local persistente (.data/mandato.db).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# PROVEDORES DE IA ADICIONAIS (Opcional):
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
